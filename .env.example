# Copy to .env.local. Values must be in quotes because some passwords contain '#'.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="food_delivery"
# one MySQL account per role (created by database/06_roles.sql)
DB_PASS_CUSTOMER="Cust#2026app"
DB_PASS_OWNER="Owner#2026app"
DB_PASS_PARTNER="Partner#2026app"
DB_PASS_ADMIN="Admin#2026app"
# Redis / Memurai ACL users (created by redis/01_setup.redis)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_USER="fd_api"
REDIS_PASS="Api#2026redis"
REDIS_TRACK_USER="fd_tracking"
REDIS_TRACK_PASS="Track#2026redis"
JWT_SECRET="change-me-to-a-long-random-string"
